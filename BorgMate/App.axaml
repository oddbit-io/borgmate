<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BorgMate.App"
             xmlns:local="using:BorgMate"
             RequestedThemeVariant="Default"
             Name="BorgMate">

    <!-- Brand accent; SystemColorsBinder replaces these with the OS accent on Windows and macOS. -->
    <Application.Resources>
        <Color x:Key="AccentColor">#2857B8</Color>
        <Color x:Key="AccentHoverColor">#3D9BFF</Color>
        <Color x:Key="AccentPressedColor">#0060DF</Color>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <SimpleTheme />
        <StyleInclude Source="avares://BorgMate/Themes/BorgTheme.axaml" />
        <StyleInclude Source="avares://BorgMate/Presentation/Controls/SidebarButton.axaml" />
        <StyleInclude Source="avares://BorgMate/Presentation/Controls/ToolbarButton.axaml" />
        <StyleInclude Source="avares://BorgMate/Presentation/Controls/DetailPanel.axaml" />
    </Application.Styles>

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="About BorgMate" Click="OnAboutClicked" />
            <NativeMenuItemSeparator />
        </NativeMenu>
    </NativeMenu.Menu>
</Application>