<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Spelled like the AvaloniaResource item, so every OS stores the default window icon once and builds the same assembly. -->
        <ApplicationIcon>Assets\borgmate.ico</ApplicationIcon>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <InvariantGlobalization>false</InvariantGlobalization>
        <!-- Listed so packages.lock.json also pins the runtime-specific packages of every release platform. -->
        <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    </PropertyGroup>
    <!--
        Release builds are byte-identical wherever they are built. ContinuousIntegrationBuild maps source paths to /_/,
        which RegexGenerator hashes into type names. No PDB is produced because the Avalonia XAML compiler writes the
        absolute App.axaml path into it, and the PDB checksum is part of the assembly.
    -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BorgMate.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
        <EmbeddedResource Include="Resources\Platform\**"/>
        <EmbeddedResource Include="Resources\Updates\**"/>
        <EmbeddedResource Include="..\changelog-v2.json" LogicalName="BorgMate.Resources.Updates.changelog-v2.json"/>
        <None Include="..\THIRD-PARTY-NOTICES" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
        <None Include="..\COPYING" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.6" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
        <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.6" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0"/>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
        <PackageReference Include="Humanizer.Core" Version="3.0.10"/>
        <PackageReference Include="Humanizer.Core.ru" Version="3.0.10"/>

        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.15" />
        <PackageReference Include="OneOf" Version="3.0.271"/>
        <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0"/>
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0"/>
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
        <PackageReference Include="Velopack" Version="1.2.161" />
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
    </ItemGroup>

</Project>
