<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:BorgMate.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:BorgMate.Presentation.ViewModels"
             xmlns:controls="clr-namespace:BorgMate.Presentation.Controls"
             xmlns:conv="clr-namespace:BorgMate.Presentation.Converters"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="600"
             x:Class="BorgMate.Presentation.Views.RepositoryListView"
             x:DataType="viewModels:RepositoriesPageViewModel">

    <Design.DataContext>
        <x:Static Member="viewModels:DesignData.RepositoriesPage" />
    </Design.DataContext>

    <DockPanel>
        <!-- Action buttons -->
        <Border DockPanel.Dock="Top" Classes="toolbar">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <controls:ToolbarButton Icon="PlusLg"
                                        Label="{Binding [CreateNew], Source={x:Static loc:Strings.Instance}}"
                                        Command="{Binding AddNewCommand}" />
                <controls:ToolbarButton Icon="Folder2Open"
                                        Label="{Binding [OpenExisting], Source={x:Static loc:Strings.Instance}}"
                                        Command="{Binding OpenExistingCommand}" />
                <controls:ToolbarButton Icon="PencilSquare"
                                        Label="{Binding [Edit], Source={x:Static loc:Strings.Instance}}"
                                        Command="{Binding EditRepositoryCommand}"
                                        CommandParameter="{Binding SelectedRepository}"
                                        IsEnabled="{Binding CanEditOrRemove}" />
                <controls:ToolbarButton Icon="PlayFill"
                                        Label="{Binding [Backup], Source={x:Static loc:Strings.Instance}}"
                                        Command="{Binding RunBackupCommand}"
                                        IsEnabled="{Binding CanRunBackup}" />
                <controls:ToolbarButton IsEnabled="{Binding CanEditOrRemove}"
                                        Icon="ThreeDotsVertical"
                                        Label="{Binding [More], Source={x:Static loc:Strings.Instance}}"
                                        Name="MoreButton">
                    <controls:ToolbarButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="{Binding [Compact], Source={x:Static loc:Strings.Instance}}"
                                      Command="{Binding CompactRepoCommand}">
                                <MenuItem.Icon>
                                    <controls:BootstrapIcon Kind="ArrowsCollapse" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding [Check], Source={x:Static loc:Strings.Instance}}"
                                      Command="{Binding CheckRepoCommand}">
                                <MenuItem.Icon>
                                    <controls:BootstrapIcon Kind="ShieldCheck" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="{Binding [Prune], Source={x:Static loc:Strings.Instance}}"
                                      Command="{Binding PruneRepoCommand}"
                                      IsEnabled="{Binding SelectedRepository.PruneOptions.HasAnyRetention, FallbackValue=False}">
                                <MenuItem.Icon>
                                    <controls:BootstrapIcon Kind="Scissors" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{Binding [ChangePassphrase], Source={x:Static loc:Strings.Instance}}"
                                      Command="{Binding ChangePassphraseCommand}"
                                      IsEnabled="{Binding SelectedRepository.IsEncrypted, FallbackValue=False}">
                                <MenuItem.Icon>
                                    <controls:BootstrapIcon Kind="KeyFill" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{Binding [Duplicate], Source={x:Static loc:Strings.Instance}}"
                                      Command="{Binding DuplicateRepositoryCommand}"
                                      CommandParameter="{Binding SelectedRepository}">
                                <MenuItem.Icon>
                                    <controls:BootstrapIcon Kind="Files" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="{Binding [Remove], Source={x:Static loc:Strings.Instance}}"
                                      Command="{Binding RemoveRepositoryCommand}"
                                      CommandParameter="{Binding SelectedRepository}">
                                <MenuItem.Icon>
                                    <controls:BootstrapIcon Kind="Trash" Width="14" Height="14" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </controls:ToolbarButton.Flyout>
                </controls:ToolbarButton>
            </StackPanel>
        </Border>

        <!-- Repository detail panel (bottom) -->
        <controls:DetailPanel DockPanel.Dock="Bottom"
                              ShowPlaceholder="{Binding SelectedRepository, Converter={x:Static ObjectConverters.IsNull}}"
                              PlaceholderText="{Binding [SelectRepoDetail], Source={x:Static loc:Strings.Instance}}"
                              IconKind="Database"
                              Title="{Binding SelectedRepository.Name}"
                              Subtitle="{Binding SelectedRepository.Path}"
                              IsLoading="{Binding SelectedRepository.IsLoadingStats, FallbackValue=False}"
                              RefreshCommand="{Binding FetchStatsCommand}">
            <controls:DetailPanel.ShowRefreshButton>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="AutoLoadStats" Converter="{x:Static BoolConverters.Not}" />
                    <Binding Path="SelectedRepository.IsLoadingStats" Converter="{x:Static BoolConverters.Not}" />
                </MultiBinding>
            </controls:DetailPanel.ShowRefreshButton>
            <StackPanel Spacing="2">
                <controls:ProgressPanel DataContext="{Binding Progress}" />
                <Grid ColumnDefinitions="120,8,*" RowDefinitions="Auto,4,Auto">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="SelectedRepository.HasStats" />
                            <Binding Path="Progress.HasActiveJob" Converter="{x:Static BoolConverters.Not}" />
                        </MultiBinding>
                    </Grid.IsVisible>
                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="secondary"
                               Text="{Binding [TotalSize], Source={x:Static loc:Strings.Instance}}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Classes="secondary"
                               Text="{Binding SelectedRepository.StatsTotalSize, Converter={x:Static conv:FormatBytesConverter.Instance}}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="secondary"
                               Text="{Binding [TotalChunks], Source={x:Static loc:Strings.Instance}}" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="secondary"
                               Text="{Binding SelectedRepository.StatsTotalChunks, Converter={x:Static conv:FormatNumberConverter.Instance}}" />
                </Grid>
            </StackPanel>
        </controls:DetailPanel>

        <!-- Repository list header -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" MinHeight="32">
            <TextBlock Text="{Binding [Repositories], Source={x:Static loc:Strings.Instance}}" FontWeight="SemiBold"
                       FontSize="{StaticResource SecondaryFontSize}" Foreground="{DynamicResource SecondaryTextBrush}"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Repository list -->
        <ListBox ItemsSource="{Binding Repositories}"
                 SelectedItem="{Binding SelectedRepository}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
                <Style Selector="ListBoxItem:selected controls|SpinnerControl">
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="ListBoxItem:selected controls|CircularProgressControl">
                    <Setter Property="Foreground" Value="White" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="viewModels:RepositoryViewModel">
                    <DockPanel Margin="8,4" MinHeight="30">
                        <Grid Width="18" Height="18" VerticalAlignment="Center" Margin="4,0,14,0">
                            <controls:BootstrapIcon Kind="Database" Width="18" Height="18">
                                <controls:BootstrapIcon.IsVisible>
                                    <Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}" />
                                </controls:BootstrapIcon.IsVisible>
                            </controls:BootstrapIcon>
                            <controls:SpinnerControl Width="16" Height="16"
                                                     Foreground="{DynamicResource SecondaryTextBrush}">
                                <controls:SpinnerControl.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsBusy" />
                                        <Binding Path="CommandProgress" Converter="{x:Static ObjectConverters.IsNull}" />
                                    </MultiBinding>
                                </controls:SpinnerControl.IsVisible>
                            </controls:SpinnerControl>
                            <controls:CircularProgressControl Width="18" Height="18"
                                                              Value="{Binding CommandProgress}"
                                                              Foreground="{DynamicResource SecondaryTextBrush}">
                                <controls:CircularProgressControl.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="IsBusy" />
                                        <Binding Path="CommandProgress"
                                                 Converter="{x:Static ObjectConverters.IsNotNull}" />
                                    </MultiBinding>
                                </controls:CircularProgressControl.IsVisible>
                            </controls:CircularProgressControl>
                        </Grid>
                        <!-- Error indicator: docked right, vertically centered, tooltip shows the full LastError. -->
                        <controls:BootstrapIcon DockPanel.Dock="Right"
                                                Kind="ExclamationCircle"
                                                Width="16" Height="16"
                                                VerticalAlignment="Center"
                                                Margin="8,0,4,0"
                                                Foreground="{StaticResource ValidationErrorBrush}"
                                                IsVisible="{Binding HasError}"
                                                ToolTip.Tip="{Binding LastError}" />
                        <StackPanel VerticalAlignment="Center" ToolTip.Tip="{Binding Path}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <controls:BootstrapIcon Kind="Clock" Width="10" Height="10"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                                        IsVisible="{Binding IsScheduled}" />
                                <TextBlock Classes="secondary"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static conv:ScheduleDisplayConverter.Instance}">
                                            <Binding Path="." />
                                            <Binding Path="IsScheduled" />
                                            <Binding Path="LastBackupAt" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>